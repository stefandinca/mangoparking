# ParkVia (ParkCloud) non-secret config — loaded automatically by Firebase
# deploy for project mango-parking. The two API keys are Secret Manager
# secrets (PARKVIA_SUBSCRIPTION_KEY / PARKVIA_OPERATOR_KEY), NOT here.
# Operator Id confirmed via the ParkCloud developer portal "Get Operators"
# call (ManGo Parking - Park & Ride - Open Air).
PARKVIA_PARKING_ID=15777
PARKVIA_BASE_URL=https://parkcloud.azure-api.net

# Parkos non-secret config. The OAuth2 client secret is a Secret Manager secret
# (PARKOS_CLIENT_SECRET), NOT here — set it with:
#   firebase functions:secrets:set PARKOS_CLIENT_SECRET
# Merchant id confirmed live via GET /v1/merchants ("ManGo Parking",
# Bucharest Otopeni Airport, RON).
PARKOS_CLIENT_ID=1610
PARKOS_MERCHANT_ID=3079
PARKOS_BASE_URL=https://api.parkos.com
