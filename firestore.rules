rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return isAuthenticated() && userRole() == 'admin';
    }
    // Agent role (renamed from 'staff'). Both names are accepted for
    // back-compat — legacy docs still carry role: 'staff'.
    function isAgent() {
      return isAuthenticated() && userRole() in ['admin', 'agent', 'staff'];
    }
    // Any backoffice user: admin, agent (or legacy staff), driver. Use for
    // check-in/check-out operations that the shuttle driver also performs.
    function isStaff() {
      return isAuthenticated() && userRole() in ['admin', 'agent', 'staff', 'driver'];
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Settings - public read, admin write
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Pricing tiers - public read, admin write
    match /pricingTiers/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Add-ons - public read, admin write
    match /addOns/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Token packs - public read, admin write
    match /tokenPacks/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Seasonal pricing periods — public read so the booking page can apply
    // them client-side. Admin-only writes; the overlap check is enforced
    // in the admin UI (server-side price recomputation is a separate
    // hygiene task — see v.1.4 plan for the Netopia v2 migration where
    // we'll re-derive totals from authoritative rates).
    match /seasonalPricing/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Promo vouchers:
    //   • public vouchers are anonymously readable (Promotions page lists them)
    //   • admins read everything (management UI)
    //   • private vouchers are restricted to their assigned uids
    // Admin-only writes for all of the above. Public branch first so it
    // resolves without ever touching auth — list queries from anonymous
    // users with where('visibility', '==', 'public') pass without
    // evaluating the authed branches.
    match /promoVouchers/{id} {
      allow read: if resource.data.visibility == 'public'
                  || isAdmin()
                  || (isAuthenticated() && request.auth.uid in resource.data.assignedUserIds);
      allow write: if isAdmin();
    }

    // Site content — admin-editable page bodies (currently just the
    // Promotions page; structured so we can add more keyed entries).
    match /siteContent/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Voucher redemption ledger — server-written only. Read by admin for
    // audit + by the owning user to see their own redemption history.
    match /voucherRedemptions/{id} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    // Per-identity day balances for splittable days vouchers — admin SDK
    // only (createPayment transaction + resolveVoucher). Staff may read
    // for support lookups.
    match /voucherDayBalances/{id} {
      allow read: if isStaff();
      allow create, update, delete: if false;
    }

    // Token balances — all balance movement is server-side (creditTokens,
    // checkInWithCredits, adminGrantCredits/adminDeductCredits, guest merge).
    // Owner reads their own uid-keyed doc; staff read anything (plate lookup
    // at the desk). No client writes: the old rules left plate_* docs
    // world-creatable/updatable/readable, so anyone could mint a guest
    // balance (staff plate-lookup would then happily deduct from it — free
    // parking) or read guest contact PII. The only client writer was the
    // dead legacy tokenService.purchaseTokens path.
    match /tokenBalances/{docId} {
      allow read: if isStaff() || (isAuthenticated() && docId == request.auth.uid);
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // Token transactions - append-only log
    // Clients may not write `use` entries — those originate from
    // admin/staff actions via the tokenService and bypass rules through
    // the admin SDK on the server side; allowing clients to seed them
    // would spam the `credit-used` email trigger.
    match /tokenTransactions/{id} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow create: if request.resource.data.type != 'use';
      allow update, delete: if false;
    }

    // Active check-ins - staff read/write
    match /activeCheckIns/{plate} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // Vouchers - one per user. Doc ID is the owning user's uid which
    // enforces ONE signup voucher per account (a second create collides).
    // Client may only create the signup-incentive voucher with the exact
    // configured amount. Client cannot update/delete — the IPN callback
    // (admin SDK) flips status to 'redeemed' atomically with fulfilment.
    match /vouchers/{voucherId} {
      // Owner reads their own; admin reads any (for the /admin/users detail view).
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated()
                    && voucherId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.source == 'signup-incentive'
                    && request.resource.data.status == 'unused'
                    && request.resource.data.amount == 20;
      allow update, delete: if false;
    }

    // Pending orders - public read by orderId (for /booking/return polling).
    // All writes go through Cloud Functions (admin SDK) — there is no
    // legitimate path for a client (even staff) to flip money-bearing
    // fields directly. The adminMarkOrderPaid / adminMarkOrderUnpaid
    // callables exist precisely to perform the side-effects (credit grant,
    // booking patch, audit log) that a raw rule write would skip.
    match /pendingOrders/{id} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // Bookings — customer reads own, staff reads all. Creation/mutation is
    // server-side (createBookingFromOrder, adminCreateLongtermBooking, …) or
    // staff client flows (check-in/out, edit details). Customers get NO
    // direct writes: self-cancel goes through the cancelBookingWithRefund
    // callable. The old `create: isAuthenticated()` + owner-update rules let
    // any account forge a paid/active booking (occupying a spot for free) or
    // flip its own pay-at-pickup booking to 'paid' without paying and then
    // check in.
    match /bookings/{id} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // Subscriptions - customer reads own, admin read/write
    match /subscriptions/{id} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isStaff() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Spots - public read, staff/admin write
    match /spots/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Shuttle schedule - public read, staff/admin write
    match /shuttleSchedule/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Train schedule - public read
    match /trainSchedule/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Users - self read/write (except role), admin full access
    match /users/{uid} {
      allow read: if isOwner(uid) || isStaff();
      allow create: if isOwner(uid) && request.resource.data.role == 'customer';
      allow update: if (isOwner(uid) && request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isAdmin();
    }

    // Audit log - staff/admin read, append-only
    match /auditLog/{id} {
      allow read: if isStaff();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Contact messages - public create, admin read
    match /contactMessages/{id} {
      allow create: if true;
      allow read: if isStaff();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // Reviews - public read, admin write. Managed from the admin-only Public
    // website section (consolidated out of the old /admin/reviews; agents no
    // longer moderate reviews).
    match /reviews/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Facility gallery images — public read (homepage "Our facility"), admin
    // write (managed from the Public website admin section). The image files
    // live in Storage under gallery/ (see storage.rules).
    match /galleryImages/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Door-to-airport transfers — private airport transfer reservations
    // recorded by staff. No money fields (the optional `price` is a free-text
    // note), so these are client-written like reviews/contact messages. Any
    // backoffice user reads/creates/updates; delete is limited to admin/agent
    // so a driver can't remove records.
    match /transfers/{id} {
      allow read, create, update: if isStaff();
      allow delete: if isAgent();
    }

    // Pending invites - admin SDK only (adminSendInvite / finishInviteSignup)
    match /pendingInvites/{email} {
      allow read, write: if false;
    }

    // ANAF CUI lookup cache - admin SDK only (lookupCui callable)
    match /lookupCache/{key} {
      allow read, write: if false;
    }

    // Legal pages — public read so the customer-facing /terms, /privacy,
    // etc. routes can render admin-edited content. Writes are admin-only.
    match /legalPages/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Cash handovers — agent/admin read for the cashbook page (drivers
    // intentionally excluded since they don't handle money). Writes go
    // through the recordCashHandover callable (admin SDK), so the rule
    // here blocks all client writes.
    match /cashHandovers/{id} {
      allow read: if isAgent();
      allow create, update, delete: if false;
    }

    // Cash entries — per-payment ledger powering /admin/cashbook. Agents
    // read their own; admins read everyone's. All writes are server-side
    // (recordCashEntry helper, closeCashbook callable).
    match /cashEntries/{id} {
      allow read: if isAdmin() || (isAgent() && resource.data.agentUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // Closed cashbook reports — same access model: agents see their own,
    // admins see all. Reports are immutable once generated.
    match /cashbookReports/{id} {
      allow read: if isAdmin() || (isAgent() && resource.data.agentUid == request.auth.uid);
      allow create, update, delete: if false;
    }
  }
}
