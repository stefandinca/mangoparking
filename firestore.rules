rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isAdmin() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isStaff() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'staff'];
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Settings - public read, admin write
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Pricing tiers - public read, admin write
    match /pricingTiers/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Add-ons - public read, admin write
    match /addOns/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Token packs - public read, admin write
    match /tokenPacks/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Token balances - owner/guest read+write, staff full access
    match /tokenBalances/{docId} {
      allow read: if isStaff() || (isAuthenticated() && docId == request.auth.uid) || docId.matches('plate_.*');
      allow create: if true;
      allow update: if isStaff() || (isAuthenticated() && docId == request.auth.uid) || docId.matches('plate_.*');
      allow delete: if isAdmin();
    }

    // Token transactions - append-only log
    match /tokenTransactions/{id} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow create: if true;
      allow update, delete: if false;
    }

    // Active check-ins - staff read/write
    match /activeCheckIns/{plate} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // Vouchers - one per user. Doc ID is the owning user's uid which
    // enforces ONE signup voucher per account (a second create collides).
    // Client may only create the signup-incentive voucher with the exact
    // configured amount. Client cannot update/delete — the IPN callback
    // (admin SDK) flips status to 'redeemed' atomically with fulfilment.
    match /vouchers/{voucherId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated()
                    && voucherId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.source == 'signup-incentive'
                    && request.resource.data.status == 'unused'
                    && request.resource.data.amount == 20;
      allow update, delete: if false;
    }

    // Pending orders - public read by orderId (for /booking/return polling).
    // The Netopia callback (admin SDK) is the canonical writer for the
    // initial create + Netopia confirmation. Staff may flip a small
    // whitelist of fields when marking a pay-at-pickup order paid at the
    // lot; the admin SDK still owns money-bearing state via callable
    // functions. Customers and unauthenticated clients still cannot write.
    match /pendingOrders/{id} {
      allow read: if true;
      allow create, delete: if false;
      allow update: if isStaff()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['paymentStatus', 'paidAt', 'paidBy', 'status']);
    }

    // Bookings - customer reads own, staff reads all
    match /bookings/{id} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isStaff() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Subscriptions - customer reads own, admin read/write
    match /subscriptions/{id} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isStaff() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Spots - public read, staff/admin write
    match /spots/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Shuttle schedule - public read, staff/admin write
    match /shuttleSchedule/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Train schedule - public read
    match /trainSchedule/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Users - self read/write (except role), admin full access
    match /users/{uid} {
      allow read: if isOwner(uid) || isStaff();
      allow create: if isOwner(uid) && request.resource.data.role == 'customer';
      allow update: if (isOwner(uid) && request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isAdmin();
    }

    // Audit log - staff/admin read, append-only
    match /auditLog/{id} {
      allow read: if isStaff();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Contact messages - public create, admin read
    match /contactMessages/{id} {
      allow create: if true;
      allow read: if isStaff();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // Reviews - public read
    match /reviews/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
